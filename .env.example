# Database (Neon / Postgres)
# Pooled URL (…-pooler… host) — fine for DATABASE_URL / app runtime.
DATABASE_URL=
# Non-pooled “direct” URL — required for `prisma migrate deploy` / migrations. In Neon Dashboard:
# Connection details → use the direct connection string (host without “-pooler”), or duplicate project and
# set only the direct endpoint here. If DIRECT_URL points at the pooler, migrations can fail with
# P1002 (advisory lock timeout).
DIRECT_URL=

# When `.env.local` overrides `DATABASE_URL` (e.g. after `vercel env pull`), set `DIRECT_URL` to the same
# Neon branch’s unpooled URL — usually the same value as `DATABASE_URL_UNPOOLED` from Vercel — so
# `npm run db:migrate` applies migrations against the database your app actually queries.

# Prisma Accelerate (optional)
PRISMA_DATABASE_URL=

# Admin access (also ok in repo-root `.env.local` next to this folder — see next.config loadEnvConfig)
ADMIN_ACCESS_CODE=
# Optional dedicated secret for signed admin session cookies (REQUIRED in production).
# Generate e.g. `openssl rand -base64 32`. If unset in production, admin login will fail closed.
# Local/dev only: a secret may be derived from ADMIN_ACCESS_CODE when this is empty.
ADMIN_SESSION_SECRET=

# Optional Upstash Redis REST — preferred shared rate limits across Vercel instances.
# When unset, rate limits use the Neon Postgres RateLimitBucket table (shared), then memory fallback.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Studio OS: automation (Airtable / n8n) for POST /api/projects/* and /api/media/upload
# Use either or both; Bearer token must match one of them.
AUTOMATION_API_SECRET=
BL_INTERNAL_API_TOKEN=

# n8n instance API (optional) — JWT from n8n Settings → API. Use only in .env.local / secrets; never commit.
# For calling n8n’s REST API from scripts or CI — not used by Next.js routes. If this key was ever pasted in chat, rotate it in n8n.
# N8N_BASE_URL=https://YOUR_SUBDOMAIN.app.n8n.cloud/api/v1
# N8N_API_KEY=

# OpenAI — project copy generation (POST /api/projects/generate-copy)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
OPENAI_MODEL=

# fal.ai — admin blog image-to-video (POST /api/admin/blog-posts/ai-video)
FAL_KEY=
# Optional override (default fal-ai/kling-video/v3/standard/image-to-video)
# FAL_IMAGE_TO_VIDEO_MODEL=

# Canva Connect — admin blog cover + social designs
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match Developer Portal redirect, e.g. https://yoursite.com/api/admin/canva/oauth/callback
CANVA_REDIRECT_URI=

# Storage (R2). Repo-root `.env.local` is merged in dev (see `lib/merge-parent-dotenv.ts` + next.config).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Public URL for R2 objects (e.g. https://pub-xxx.r2.dev or custom domain)
R2_PUBLIC_URL=
# Same as R2_PUBLIC_URL; use NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_R2_PUBLIC_URL=
# Hero video and poster (R2 keys, e.g. portfolio/hero/hero.mp4)
NEXT_PUBLIC_HERO_VIDEO_KEY=
NEXT_PUBLIC_HERO_POSTER_KEY=

# Mirotech site R2 (dual-bucket hub at /admin/r2 — Vault → Mirotech site).
# Separate bucket from Brightline; do not point primary R2_* at mirotech.
# Token should be scoped Read/Write to the Mirotech bucket only.
MIROTECH_R2_ACCESS_KEY_ID=
MIROTECH_R2_SECRET_ACCESS_KEY=
MIROTECH_R2_BUCKET=mirotech
# Optional if same Cloudflare account endpoint as R2_ENDPOINT
MIROTECH_R2_ENDPOINT=
MIROTECH_R2_REGION=auto
# Public CDN for Mirotech-site previews (e.g. https://media.mirotech.solutions)
MIROTECH_R2_PUBLIC_URL=
NEXT_PUBLIC_MIROTECH_R2_PUBLIC_URL=

# Storage (S3)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Email (Resend)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
RESEND_FROM=
# Required in production for /api/cron/followups authorization
CRON_SECRET=

# Studio OS Mission Control email (SMTP/IMAP v1)
STUDIO_OS_EMAIL_PROVIDER=smtp_imap
# Comma-separated verified @brightlinephotography.com senders (default list used if unset)
STUDIO_OS_EMAIL_ALLOWED_SENDERS=hello@brightlinephotography.com,bookings@brightlinephotography.com,kiril@brightlinephotography.com,info@brightlinephotography.com
# Gmail (or other) inbox that receives Cloudflare-forwarded mail — shown on /studio only; optional if STUDIO_OS_IMAP_USER is set
STUDIO_OS_INBOX_EMAIL=
STUDIO_OS_EMAIL_ADDRESS=
STUDIO_OS_EMAIL_FROM_NAME="Bright Line Photography"
STUDIO_OS_SMTP_HOST=
STUDIO_OS_SMTP_PORT=587
STUDIO_OS_SMTP_SECURE=false
STUDIO_OS_SMTP_USER=
STUDIO_OS_SMTP_PASS=
STUDIO_OS_IMAP_HOST=
STUDIO_OS_IMAP_PORT=993
STUDIO_OS_IMAP_SECURE=true
STUDIO_OS_IMAP_USER=
STUDIO_OS_IMAP_PASS=

# Google Calendar API (optional — Mission Control calendar sync, Phase 3)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# Google Places API (New) — blog “Import from Google review” (server-only)
# GOOGLE_PLACES_API_KEY=

# Booking
NEXT_PUBLIC_CALENDLY_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (optional - use one or both)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Error monitoring (optional — Sentry). No-op when unset.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Set SENTRY_ENABLE=1 to report from non-production
# SENTRY_ENABLE=
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Site base URL for sitemap/robots (canonical production: https://brightlinephotography.com)
NEXT_PUBLIC_SITE_URL=https://brightlinephotography.com

# Dual-brand CMS — Mirotech content API (Work + Journal shared layer)
MIROTECH_CONTENT_API_URL=https://mirotech.solutions
# Optional; must match Mirotech CONTENT_API_SECRET when that is set
CONTENT_API_SECRET=

# Mirotech admin SSO from Brightline sidebar (same secret on both Vercel projects, 32+ chars)
MIROTECH_SITE_URL=https://mirotech.solutions
MIROTECH_ADMIN_HANDOFF_SECRET=

# Stripe payments for Studio OS invoices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin seed endpoint (dev only - do not set in production)
SEED_TOKEN=
