{
  "name": "brightline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "db:migrate": "node scripts/prisma-with-local-env.mjs migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prep": "node scripts/prep-images.mjs",
    "prep:once": "node scripts/prep-images.mjs --root \"${EXPORTS_ROOT:-/Users/kiril/Desktop/brightline/BrightLine_images/Exports}\" --section ${SECTION:-acd}",
    "blupload": "node scripts/blupload.mjs",
    "blupload:once": "node scripts/blupload.mjs --root \"${EXPORTS_ROOT:-/Users/kiril/Desktop/brightline/BrightLine_images/Exports}\" --section ${SECTION:-acd} --project ${PROJECT:-ci-siamo} --location ${LOCATION:-nyc} --year ${YEAR:-2026}",
    "pipeline:once": "npm run prep:once && npm run blupload:once",
    "pipeline:clean": "npm run prep:once && npm run blupload:once -- --clean",
    "blpublish": "node scripts/blpublish.mjs",
    "publish:db": "node ../tools/publish.mjs",
    "sheet-publish": "node scripts/sheet-publish.mjs",
    "upload-published": "node scripts/upload-published.mjs",
    "watch:deploy": "node scripts/watch-deploy.mjs",
    "sheet:ping": "node ../tools/verify-sheet-api.mjs --ping",
    "sheet:verify": "node ../tools/verify-sheet-api.mjs",
    "studio-os:verify": "node scripts/verify-studio-os-api.mjs",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "deploy:prod:studio-os": "REQUIRED_GIT_BRANCH=studio-os-cms-production-20260425 bash scripts/deploy-prod.sh",
    "deploy:check": "node scripts/check-prod-deploy-ready.mjs"
  },
